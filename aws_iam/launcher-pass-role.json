{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyKontextWorkerToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::340752821887:role/KontextTrainingWorker",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    }
  ]
}
